{
  "name": "dsh-agent-usage",
  "version": "1.0.0",
  "type": "module",
  "description": "Left-sidebar panel showing today's session count and token consumption for local agent clients (Claude desktop, Qwen Work, WorkBuddy, MiniMax Code, and DeepSeek Harness).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "scanner.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "screenshots.json",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hds1989824/dsh-agent-usage.git"
  },
  "homepage": "https://github.com/hds1989824/dsh-agent-usage#readme",
  "bugs": { "url": "https://github.com/hds1989824/dsh-agent-usage/issues" },
  "engines": { "node": ">=22.15" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
